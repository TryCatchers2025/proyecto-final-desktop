<!-- Vista principal de reservas: listado, filtros, ordenación y paginación -->
<UserControl x:Class="PereMaria.GestorHotel.Views.BookingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
    xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    DataContext="{x:Static controllers:BookingsViewModel.Instance}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0"
            LastChildFill="False">
            <Button Style="{StaticResource ActionButtonStyle}"
                DockPanel.Dock="Left"
                Margin="5 20 5 4 "
                Command="{Binding NavigateFormCommand}">
                Nueva Reserva
            </Button>
            <Grid DockPanel.Dock="Left"
                Width="260"
                Margin="14 22 12 4">
                <TextBox x:Name="TableSearchBox"
                    Style="{StaticResource TextBoxStyle}"
                    Padding="34 10 10 10"
                    Text="{Binding TableSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="search"
                    HorizontalAlignment="Left"
                    FontFamily="{StaticResource Material-Icons}"
                    Foreground="{StaticResource Bg-Purple-Accent}"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0" />
            </Grid>
            <StackPanel DockPanel.Dock="Left"
                Orientation="Horizontal"
                Margin="12 0">
                <StackPanel Margin="0 0 12 0">
                    <TextBlock Text="Desde"
                        Style="{StaticResource TableSubText}" />
                    <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay}"
                        SelectedDateFormat="Short"
                        Margin="0 4 0 0"
                        Style="{StaticResource DatePickerStyle}"
                        Width="140" />
                </StackPanel>
                <StackPanel Margin="0 0 12 0">
                    <TextBlock Text="Hasta"
                        Style="{StaticResource TableSubText}" />
                    <DatePicker SelectedDate="{Binding FilterEndDate, Mode=TwoWay}"
                        SelectedDateFormat="Short"
                        Margin="0 4 0 0"
                        Style="{StaticResource DatePickerStyle}"
                        Width="140" />
                </StackPanel>
                <Button Style="{StaticResource IconBaseButton}"
                    Command="{Binding ClearDateFiltersCommand}"
                    Margin="0 18 0 0"
                    VerticalAlignment="Center">
                    close
                </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Left"
                Text="{Binding DateFilterError}"
                Foreground="{StaticResource Bg-Warning}"
                FontWeight="SemiBold"
                Margin="12 0 0 0"
                VerticalAlignment="Center"
                Visibility="{Binding HasDateFilterError, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource IconBaseButton}"
                Command="{Binding ReloadCommand}"
                DockPanel.Dock="Right"
                VerticalAlignment="Center">
                refresh
            </Button>
        </DockPanel>
        <Border Grid.Row="1"
            Style="{StaticResource TableContainerStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Row -->
                <Border Grid.Row="0"
                    Style="{StaticResource TableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Huesped"
                            Grid.Column="0"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="DNI"
                            Grid.Column="1"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Habitación"
                            Grid.Column="2"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Entrada"
                            Grid.Column="3"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Salida"
                            Grid.Column="4"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Total"
                            Grid.Column="5"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Pago"
                            Grid.Column="6"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                        <TextBlock Text="Estado"
                            Grid.Column="7"
                            Style="{StaticResource TableSubText}"
                            FontWeight="SemiBold" />
                    </Grid>
                </Border>
                <!-- Data Rows -->
                <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PagedBookings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRowStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding
                                            Gesture="LeftClick"
                                            Command="{Binding DataContext.NavigateFormCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>


                                        <StackPanel Grid.Column="0"
                                            Orientation="Vertical">
                                            <TextBlock
                                                Style="{StaticResource TableMainText}"
                                                VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Customer.FirstName"></Binding>
                                                        <Binding Path="Customer.LastName"></Binding>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock
                                                Style="{StaticResource TableSubText}"
                                                Text="VIP"
                                                Visibility="{Binding Customer.Vip, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Customer.Dni}"
                                            Grid.Column="1"
                                            Style="{StaticResource TableMutedText}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource TableMainText}"
                                            VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} - {1}">
                                                    <Binding Path="Room.Name"></Binding>
                                                    <Binding Path="Room.Type"></Binding>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StartDate}"
                                            Grid.Column="3"
                                            Style="{StaticResource TableMutedText}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding EndDate}"
                                            Grid.Column="4"
                                            Style="{StaticResource TableMutedText}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:c}}"
                                            Grid.Column="5"
                                            Style="{StaticResource TableMutedText}"
                                            VerticalAlignment="Center" />
                                        <Border Grid.Column="6"
                                            CornerRadius="10"
                                            Padding="10,6"
                                            Margin="5 0"
                                            VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                        Value="{StaticResource Bg-Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaid}"
                                                            Value="True">
                                                            <Setter Property="Background"
                                                                Value="{StaticResource Bg-Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                            Value="Pago pendiente" />
                                                        <Setter Property="Foreground"
                                                            Value="{StaticResource Bg-Dark}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaid}"
                                                                Value="True">
                                                                <Setter Property="Text"
                                                                    Value="Pagada" />
                                                                <Setter Property="Foreground"
                                                                    Value="{StaticResource Text-Primary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Border Grid.Column="7"
                                            CornerRadius="10"
                                            Padding="10,6"
                                            Margin="5 0"
                                            Background="{Binding Status, Converter={StaticResource BookingStatusToBadgeBrush}}"
                                            VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"
                                                Foreground="{StaticResource Text-Primary}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding Status, Converter={StaticResource BookingStatusToBadgeText}}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading overlay -->
                <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontWeight="UltraBold">Cargando...</TextBlock>
                </Border>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2"
            LastChildFill="False"
            Margin="0 10 0 0">
            <StackPanel Orientation="Horizontal"
                DockPanel.Dock="Left">
                <TextBlock Text="Filas por pagina"
                    VerticalAlignment="Center"
                    Margin="0 0 8 0" />
                <ComboBox Width="90"
                    Style="{StaticResource DropdownStyle}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding SelectedPageSize}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                DockPanel.Dock="Right">
                <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding PreviousPageCommand}">
                    Anterior
                </Button>
                <TextBlock Text="{Binding PageSummary}"
                    VerticalAlignment="Center"
                    Margin="10 0" />
                <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding NextPageCommand}">
                    Siguiente
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                DockPanel.Dock="Right"
                Margin="0 0 20 0">
                <TextBlock Text="Ordenar"
                    VerticalAlignment="Center"
                    Margin="0 0 8 0" />
                <ComboBox Width="140"
                    Style="{StaticResource DropdownStyle}"
                    ItemsSource="{Binding SortOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Key"
                    SelectedValue="{Binding SelectedSortKey}" />
                <TextBlock Text="Orden"
                    VerticalAlignment="Center"
                    Margin="12 0 8 0" />
                <ComboBox Width="90"
                    Style="{StaticResource DropdownStyle}"
                    ItemsSource="{Binding SortDirectionOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Key"
                    SelectedValue="{Binding SelectedSortDirection}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>