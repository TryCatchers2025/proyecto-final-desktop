<UserControl x:Class="PereMaria.GestorHotel.Views.BookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PereMaria.GestorHotel.Views"
             xmlns:controllers="clr-namespace:PereMaria.GestorHotel.Controllers"
             mc:Ignorable="d"
             DataContext="{x:Static controllers:BookingsController.Instance}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Click="OnNewClick">Nuevo</Button>
        <ListView Grid.Row="1" ItemsSource="{Binding Bookings}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding BookingId}"></GridViewColumn>
                    <GridViewColumn Header="Habitación" DisplayMemberBinding="{Binding RoomId}"></GridViewColumn>
                    <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding UserId}"></GridViewColumn>
                    <GridViewColumn Header="Fecha de Inicio" DisplayMemberBinding="{Binding StartDate}"></GridViewColumn>
                    <GridViewColumn Header="Fecha de Fin" DisplayMemberBinding="{Binding EndDate}"></GridViewColumn>
                    <GridViewColumn Header="Fecha de Reserva" DisplayMemberBinding="{Binding BookingDate}"></GridViewColumn>
                    <GridViewColumn Header="# de Huespedes" DisplayMemberBinding="{Binding Occupants}"></GridViewColumn>
                    <GridViewColumn Header="Precio Por noche" DisplayMemberBinding="{Binding PricePerNight}"></GridViewColumn>
                    <GridViewColumn Header="Precio Total" DisplayMemberBinding="{Binding TotalPrice}"></GridViewColumn>
                    <GridViewColumn Header="Porcentaje de descuento" DisplayMemberBinding="{Binding Discount}"></GridViewColumn>
                    <GridViewColumn Header="Cantidad de noches" DisplayMemberBinding="{Binding TotalNights}"></GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>